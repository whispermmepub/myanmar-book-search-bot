{
  "name": "myanmar-book-search-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:local": "wrangler d1 migrations apply book-search --local",
    "db:remote": "wrangler d1 migrations apply book-search --remote",
    "webhook": "node scripts/webhook.mjs",
    "import:railway": "node scripts/import-railway.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20250927.0",
    "@types/node": "^22.18.0",
    "miniflare": "4.20250924.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "4.40.0"
  }
}
