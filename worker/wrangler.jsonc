{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "myanmar-book-search-bot",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-27",
  "workers_dev": true,
  "observability": { "enabled": true },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "book-search",
    "database_id": "7f48e3bc-ac9b-43d3-8dab-a768b147bdfc",
    "migrations_dir": "migrations"
  }],
  // R2 is optional; Telegram file_id caching keeps cover delivery working without it.
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "BOT_USERNAME": "saroatsarpay_bot",
    "REFRESH_HOURS": "6",
    "NOTIFY_MAX_PER_REFRESH": "25",
    "NOTIFICATION_BATCH": "3",
    "DELETE_BATCH": "5",
    "INBOX_BATCH": "2",
    "AUTO_DELETE_SECONDS": "300",
    "STATE_TTL_HOURS": "168",
    "WARM_COVERS_PER_TICK": "1"
  }
}
